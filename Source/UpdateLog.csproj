<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Authors>Smash Phil</Authors>
        <Description>Update log tool for showing change notes ingame.</Description>
        <Product>Update Log</Product>
        <FileVersion>1.6.0</FileVersion>
        <AssemblyVersion>1.6.0</AssemblyVersion>
        <CurrentDate>$([System.DateTime]::Now.ToString(yyyy/MM/dd HH:mm:ss))</CurrentDate>

        <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
        <Configurations>Debug;Unstable;Release;ReleaseTesting</Configurations>
        <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
        <ProjectGuid>{04DF45B1-9D4D-40A6-A51D-3DCB146A53C8}</ProjectGuid>
        <OutputType>Library</OutputType>
        <RootNamespace>UpdateLogTool</RootNamespace>
        <AssemblyName>UpdateLogTool</AssemblyName>
        <TargetFramework>net48</TargetFramework>
        <FileAlignment>512</FileAlignment>
        <LangVersion>8.0</LangVersion>
