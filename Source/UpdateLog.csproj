    <!--Build Configurations -->
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <DebugSymbols>true</DebugSymbols>
        <Optimize>false</Optimize>
        <DefineConstants>TRACE;DEBUG;UNITY_ASSERTIONS;DEV_TOOLS</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Unstable|AnyCPU'">
        <DebugSymbols>true</DebugSymbols>
        <Optimize>true</Optimize>
        <DefineConstants>TRACE;UNSTABLE;</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <DebugSymbols>true</DebugSymbols>
        <Optimize>true</Optimize>
        <DefineConstants>TRACE;RELEASE;</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'ReleaseTesting|AnyCPU'">
	    <DebugSymbols>true</DebugSymbols>
	    <Optimize>true</Optimize>
	    <DefineConstants>TRACE;RELEASE;UNITY_ASSERTIONS;DEV_TOOLS;</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <!-- Nuget -->
			<PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" />
			<PackageReference Include="Lib.Harmony.Ref" Version="2.4.2" />
			<PackageReference Include="PolySharp" Version="1.*" />

        <!--Local -->
        <Reference Include="CoreLib">
	        <HintPath>$(OutDir)\CoreLib.dll</HintPath>
	        <Private>False</Private>
        </Reference>

		<Reference Include="SmashTools">
			<HintPath>$(OutDir)\SmashTools.dll</HintPath>
			<Private>False</Private>
		</Reference>
